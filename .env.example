DATABASE_URL=postgresql+psycopg://netmgr:netmgr@db:5432/netmgr
MONITORING_ENABLED=false
POLL_INTERVAL_SECONDS=60
SNMP_COMMUNITY=
SYSLOG_ENABLED=true
SYSLOG_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514
# Example: {"ios-lab-1":{"username":"LAB_USER","password":"LAB_PASSWORD","secret":"ENABLE_SECRET"}}
NETMGR_DEVICE_CREDENTIALS_JSON={}

# DNS is disabled unless explicitly enabled. External name forwarding (R5.4)
# is optional; leave DNS_UPSTREAM_HOST blank to keep authoritative-only behavior.
DNS_ENABLED=false
DNS_HOST=0.0.0.0
DNS_PORT=53
DNS_UPSTREAM_HOST=
DNS_UPSTREAM_PORT=53
DNS_FORWARD_TIMEOUT=2
