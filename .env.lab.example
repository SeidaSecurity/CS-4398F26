# Template for running the app natively on Windows against the CML lab (lab/README.md).
# Copy to .env.lab (git-ignored) and replace every REPLACE_WITH_* value:
#   Copy-Item .env.lab.example .env.lab
# scripts/run-lab.ps1 refuses to start while any REPLACE_WITH_* placeholder remains.

# No DATABASE_URL -> the app uses a local SQLite file (network_manager.db in the repo root).

# First admin account, created on startup only if no users exist (R7.4).
# Password: 8-64 characters, not a common password, not the same as the username.
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

# Key that encrypts device credentials stored in the database (R1.4, NFR-6; ADR-0008).
# Generate: .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NETMGR_SECRET_KEY=REPLACE_WITH_FERNET_KEY

MONITORING_ENABLED=true
# Raise an alert when a device's CPU goes over this percentage (R2.5). Default 90.
CPU_ALERT_PERCENT=90
POLL_INTERVAL_SECONDS=60

# Must match "snmp-server community ... RO" in lab/configs/ios-lab-N.cfg
SNMP_COMMUNITY=REPLACE_WITH_SNMP_COMMUNITY

SYSLOG_ENABLED=true
SYSLOG_HOST=0.0.0.0
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

# DNS service (R5.1-R5.3). Port 53 must be free; see lab/README.md "DNS service".
DNS_ENABLED=true
DNS_HOST=0.0.0.0
DNS_PORT=53

# Keys must equal the device names you register in the app (Devices screen).
# Passwords must match "username lab ... secret ..." in the router configs.
NETMGR_DEVICE_CREDENTIALS_JSON={"ios-lab-1":{"username":"lab","password":"REPLACE_WITH_LAB_PASSWORD"},"ios-lab-2":{"username":"lab","password":"REPLACE_WITH_LAB_PASSWORD"},"ios-lab-3":{"username":"lab","password":"REPLACE_WITH_LAB_PASSWORD"},"ios-lab-4":{"username":"lab","password":"REPLACE_WITH_LAB_PASSWORD"}}
